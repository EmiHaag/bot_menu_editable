{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "QA Smart Watchdog",
            "type": "shell",
            "command": "npm run test:watch",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "qa-watchdog",
                "pattern": [
                    {
                        "regexp": "^[\\s\\S]*$"
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[QA Watchdog\\] Starting",
                    "endsPattern": "^\\[QA Watchdog\\] Ready"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}