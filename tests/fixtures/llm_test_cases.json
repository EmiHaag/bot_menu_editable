{
  "descripcion": "Benchmark LLM de WA Menu: valida el comportamiento determinista actual del IntentRouterService frente a los 3 escenarios del bot (Carrito, Turnos, FAQs). Usa SOLO la taxonomía de intenciones existente. El catálogo de cada perfil es un SNAPSHOT simulado en memoria (buildCatalogo), mismo patrón que aiTranslatorController._buildCatalogo.",
  "perfiles": [
    {
      "id": "CARRITO",
      "negocio": "Pizzería Don Pepito",
      "sinCarrito": false,
      "estilo": "profesional",
      "catalogo": [
        { "trigger": "pizz_muz",    "title": "Pizza Muzza",          "price": 9000,  "seccion": false },
        { "trigger": "beb_coca_1l", "title": "Coca Cola 1L",         "price": 3500,  "seccion": false },
        { "trigger": "hamb_comp",   "title": "Hamburguesa completa", "price": 12000, "seccion": false }
      ],
      "casos": [
        {
          "id": "carrito-01",
          "input": "Hola me das dos de muzza y una coca de litro",
          "expected": {
            "intencion": "AGREGAR_AL_CARRITO",
            "items": [
              { "trigger": "pizz_muz", "cantidad": 2 },
              { "trigger": "beb_coca_1l", "cantidad": 1 }
            ]
          }
        },
        {
          "id": "carrito-02",
          "input": "Cuanto sale la hamburguesa completa?",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "carrito-03",
          "input": "Quiero encargar una pizzeta muzza",
          "expected": {
            "intencion": "AGREGAR_AL_CARRITO",
            "items": [ { "trigger": "pizz_muz", "cantidad": 1 } ]
          }
        },
        {
          "id": "carrito-04",
          "input": "Me llevo dos coca de litro y una completa",
          "expected": {
            "intencion": "AGREGAR_AL_CARRITO",
            "items": [
              { "trigger": "beb_coca_1l", "cantidad": 2 },
              { "trigger": "hamb_comp", "cantidad": 1 }
            ]
          }
        },
        {
          "id": "carrito-05",
          "input": "¿Tenés una fugazzeta rellena?",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "alternativas": [ "FALLO" ],
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "carrito-06",
          "input": "Quiero la especial de la casa",
          "expected": {
            "intencion": "FALLO",
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "carrito-07",
          "input": "Hasta qué hora atienden hoy?",
          "expected": {
            "intencion": "CONSULTAR_HORARIOS"
          }
        }
      ]
    },
    {
      "id": "TURNOS",
      "negocio": "Peluquería Bella",
      "sinCarrito": false,
      "estilo": "cercano",
      "catalogo": [
        { "trigger": "turno_reserva", "title": "Reservar un turno",  "seccion": false },
        { "trigger": "mis_turnos",    "title": "Mis turnos",         "seccion": false },
        { "trigger": "horarios",      "title": "Horarios de atención", "seccion": false }
      ],
      "casos": [
        {
          "id": "turnos-01",
          "input": "Quiero reservar para cortarme el pelo mañana a las 10am",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "items": [ { "trigger": "turno_reserva" } ],
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "turnos-02",
          "input": "Necesito cambiar mi turno de las 15 hs",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "items": [ { "trigger": "mis_turnos" } ],
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "turnos-03",
          "input": "Quiero ver mis turnos",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "items": [ { "trigger": "mis_turnos" } ]
          }
        },
        {
          "id": "turnos-04",
          "input": "¿Hasta qué hora atienden?",
          "expected": {
            "intencion": "CONSULTAR_HORARIOS"
          }
        },
        {
          "id": "turnos-05",
          "input": "Vengo a pagar una coca",
          "expected": {
            "intencion": "FALLO",
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "turnos-06",
          "input": "Hola! Como andas?",
          "expected": {
            "intencion": "CHARLA_GENERAL",
            "not": [ "FALLO" ]
          }
        }
      ]
    },
    {
      "id": "FAQ",
      "negocio": "Inmobiliaria Centrox",
      "sinCarrito": true,
      "estilo": "formal",
      "catalogo": [
        { "trigger": "estacionamiento", "title": "¿Tienen estacionamiento propio?", "seccion": false },
        { "trigger": "ubicacion",       "title": "¿Cuál es la dirección del local?", "seccion": false },
        { "trigger": "casa_3h",         "title": "Casa de 3 habitaciones",          "seccion": false },
        { "trigger": "alquileres",      "title": "Alquileres",                      "seccion": true }
      ],
      "casos": [
        {
          "id": "faq-01",
          "input": "Tienen estacionamiento propio?",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "items": [ { "trigger": "estacionamiento" } ]
          }
        },
        {
          "id": "faq-02",
          "input": "Cual es la direccion del local?",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "items": [ { "trigger": "ubicacion" } ]
          }
        },
        {
          "id": "faq-03",
          "input": "Quiero la casa de 3 habitaciones",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "items": [ { "trigger": "casa_3h" } ],
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "faq-04",
          "input": "Me interesa alquilar un departamento",
          "expected": {
            "intencion": "CONSULTAR_MENU",
            "items": [ { "trigger": "alquileres" } ],
            "not": [ "AGREGAR_AL_CARRITO" ]
          }
        },
        {
          "id": "faq-05",
          "input": "¿En qué horarios atienden?",
          "expected": {
            "intencion": "CONSULTAR_HORARIOS"
          }
        },
        {
          "id": "faq-06",
          "input": "Quiero pagar mi pedido",
          "expected": {
            "intencion": "FALLO",
            "alternativas": [ "CHARLA_GENERAL" ],
            "not": [ "FINALIZAR_PEDIDO", "VER_CARRITO" ]
          }
        },
        {
          "id": "faq-07",
          "input": "Gracias por todo, buen día",
          "expected": {
            "intencion": "CHARLA_GENERAL",
            "not": [ "FALLO" ]
          }
        }
      ]
    }
  ]
}