# API key de OpenAI para el Asistente IA del plan Premium (modelo GPT-4o mini).
# Obtenela en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# API key de Jev (TypeSafe AI / System One): capa de decisiones estructuradas
# (clasificación de intención, validaciones, enrutamiento por confianza).
# Obtenela en https://console.typesafe.ai/keys
# Opcional: si no está configurada, el bot usa solo el router LLM (sin fast-path Jev).
TYPESAFE_API_KEY=

# Umbral de confianza para el Enrutamiento por Confianza (default 0.85).
# Si Jev devuelve >= umbral se ejecuta la acción directa; si no, cae al router LLM.
JEV_UMBRAL=0.85

# (Opcional) Base URL y modelo de Jev. Defaults: https://api.typesafe.ai y jev-latest.
# Pinjá TYPESAFE_MODEL (ej. jev-1.13.0) en producción si afinás umbrales.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest
